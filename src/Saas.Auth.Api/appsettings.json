{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "OpenIddict": {
    "SigningCertificatePath": "",
    "SigningCertificatePassword": "",
    "EncryptionCertificatePath": "",
    "EncryptionCertificatePassword": "",
    "Clients": []
  },
  "Features": {
    "Organizations": true,
    "PublicSignup": true
  },
  "Platform": {
    "AdministratorEmail": ""
  },
  "App": {
    "WebUrl": "http://app.localhost"
  },
  "Mail": {
    "Host": "mailpit",
    "Port": 1025,
    "FromAddress": "no-reply@saas.local",
    "FromName": "Saas"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:dd-MM-yyyy HH:mm:ss.ffff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
