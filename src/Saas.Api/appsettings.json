{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Migrations": ""
  },
  "Authentication": {
    "Authority": "http://auth:8080",
    "PublicAuthority": "http://auth.localhost",
    "RequireHttpsMetadata": false
  },
  "Features": {
    "Organizations": true,
    "PublicSignup": true
  },
  "Ai": {
    "BaseUrl": "http://ai:8000",
    "DefaultModel": "gpt-6.1-sol"
  },
  "Runs": {
    "ReaperInterval": "00:05:00",
    "StaleAfter": "00:15:00"
  },
  "Cors": {
    "Origins": [
      "http://app.localhost",
      "http://localhost:3000"
    ]
  },
  "App": {
    "WebUrl": "http://app.localhost"
  },
  "Mail": {
    "Host": "mailpit",
    "Port": 1025,
    "FromAddress": "no-reply@saas.local",
    "FromName": "Saas"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:dd-MM-yyyy HH:mm:ss.ffff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
