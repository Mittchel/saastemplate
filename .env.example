# ---------------------------------------------------------------------------
# Copy to .env and adjust. Nothing here is secret-by-default except the
# passwords and the Anthropic key; the defaults boot a working local stack.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=saas

# --- Feature flags ---------------------------------------------------------
# Organizations are ALWAYS present in the schema and every user always gets a
# personal organization. This flag only decides whether the org switcher,
# members and invites UI are shown. Flipping it needs no migration.
FEATURE_ORGS=true
# Self-service registration. With it off, /register 404s and the endpoint refuses.
FEATURE_PUBLIC_SIGNUP=true

# --- Platform operator ------------------------------------------------------
# The account that runs the deployment. On startup the identity service grants
# it the Administrator role, which lets it enter any workspace for support and
# reach the operator endpoints. It still sees one workspace at a time -- the
# role does not widen what any single token can read.
# Leave blank for no operator account.
PLATFORM_ADMIN_EMAIL=

# --- Hostnames and public URLs ---------------------------------------------
# The *_HOST values are what Traefik matches on. The *_PUBLIC_URL values are
# what the browser actually types, and what the backend puts into links and
# token issuer claims. They are stated separately because they stop matching
# as soon as the gateway is not on port 80 -- deriving the URLs from the host
# names silently produced links pointing at the wrong port.
#
# Browsers resolve *.localhost to 127.0.0.1 natively. Windows DNS does not, so
# the dev override also publishes direct ports for curl and psql.
WEB_HOST=app.localhost
API_HOST=api.localhost
AUTH_HOST=auth.localhost

# Include the port here whenever PORT_HTTP below is not 80.
WEB_PUBLIC_URL=http://app.localhost
API_PUBLIC_URL=http://api.localhost
AUTH_PUBLIC_URL=http://auth.localhost

# --- Postgres --------------------------------------------------------------
POSTGRES_DB=saas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_change_me
SAAS_OWNER_PASSWORD=owner_change_me
SAAS_APP_PASSWORD=app_change_me
SAAS_AI_PASSWORD=ai_change_me

# Owner connection: used ONLY to run EF Core migrations.
ConnectionStrings__Migrations=Host=postgres;Port=5432;Database=saas;Username=saas_owner;Password=owner_change_me
# Runtime connection: non-owner, so row-level security is enforced.
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=saas;Username=saas_app;Password=app_change_me
# AI service: its own role, its own schema, no business tables.
AI_DATABASE_URL=postgresql://saas_ai:ai_change_me@postgres:5432/saas

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Token signing ---------------------------------------------------------
# Saas.Api AND Saas-Ai both validate tokens against the identity service's
# JWKS, so the signing key must survive restarts. Generate with:
#   ./scripts/generate-certs.ps1
OIDC_SIGNING_CERT_PATH=/certs/signing.pfx
OIDC_SIGNING_CERT_PASSWORD=cert_change_me
OIDC_ENCRYPTION_CERT_PATH=/certs/encryption.pfx
OIDC_ENCRYPTION_CERT_PASSWORD=cert_change_me

# Seeded OpenIddict client used by the Next.js app for the password grant.
OIDC_CLIENT_ID=saas-web
OIDC_CLIENT_SECRET=client_change_me

# --- Service URLs (container network) --------------------------------------
AUTH_INTERNAL_URL=http://auth:8080
API_INTERNAL_URL=http://api:8080
AI_INTERNAL_URL=http://ai:8000

# --- Auth.js (Next.js) -----------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate_me
AUTH_TRUST_HOST=true
# Optional Google sign-in. Leave AUTH_GOOGLE_ID blank to hide the button.
# The id goes to both the frontend (to run the OAuth flow) and the identity
# service (to verify the resulting token audience), so they cannot drift.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- AI --------------------------------------------------------------------
# Switching provider is AI_DEFAULT_MODEL alone: the model name is looked up in
# the registry in src/saas-ai/app/llm.py, which knows its provider and prices.
#   OpenAI:    gpt-6-astra | gpt-6.1-sol | gpt-6-sol | gpt-6-luna
#              gpt-5.6-sol | gpt-5.6-luna | gpt-5.4-mini | gpt-5-mini | gpt-4o-mini
#   Anthropic: claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
AI_DEFAULT_MODEL=gpt-6.1-sol

# Only the provider in use needs a key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Fallback provider for a model not yet listed in the registry.
AI_PROVIDER=openai

# --- Dev-only published ports (docker-compose.override.yml) ----------------
# Non-default Postgres/Redis ports on purpose: these stacks are cloned per
# product and a laptop usually has another one already bound to 5432.
#
# Postgres and Redis are deliberately below 49152, not in the 50000+ range.
# Windows reserves blocks of the dynamic range for Hyper-V and WinNAT, the
# blocks move on every reboot, and a port inside one fails to bind with "an
# attempt was made to access a socket in a way forbidden by its access
# permissions" -- a stack that worked yesterday failing this morning for no
# visible reason. Check with:
#   netsh interface ipv4 show excludedportrange protocol=tcp
PORT_WEB=3000
PORT_AUTH=5001
PORT_API=5002
PORT_AI=5003
# The gateway host port. Windows frequently reserves 80 for http.sys, in which
# case Docker cannot bind it -- set this to e.g. 8000 and add the same port to
# the *_PUBLIC_URL values above.
PORT_HTTP=80
PORT_TRAEFIK_DASHBOARD=8080
PORT_MAILPIT_UI=8025
PORT_POSTGRES=15432
PORT_REDIS=16379

# --- Production only (docker-compose.prod.yml) -----------------------------
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=
# A real SMTP provider. Mailpit is development only and is scaled to zero in
# production, so leaving these blank means password resets silently vanish.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
